---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="hero">
				<p class="prompt cursor">$ cat about.txt</p>
				<h1 class="headline">
					<span>Código que</span>
					<span class="gradient">conta histórias</span>
					<span>em produção.</span>
				</h1>
				<p class="subtitle">{SITE_DESCRIPTION}</p>
				<p class="cta">
					<span class="bar" aria-hidden="true"></span>
					<a href="/posts">-&gt; ver todos os posts</a>
				</p>
			</section>
			<hr />
			<p class="label">// últimos posts</p>
			<div class="grid">
				{posts.map((post, index) => (
					<article class="card">
						<a href={`/posts/${post.id}/`} class="card-link">
							<div class="card-top">
								<span
									class={`dot ${index % 2 === 0 ? 'dot-blue' : 'dot-cyan'}`}
									aria-hidden="true"
								></span>
								<span class="card-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</div>
							<div class="card-body">
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
							{(post.data.categories[0] ?? post.data.tags[0]) && (
								<div class="card-footer">
									<span class="tag">{post.data.categories[0] ?? post.data.tags[0]}</span>
								</div>
							)}
						</a>
					</article>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2em 0 1em 0;
	}
	.prompt {
		margin: 0 0 0.5em 0;
		font-family: var(--font-mono);
		color: var(--color-text-tertiary);
		font-size: 0.9em;
	}
	.headline {
		display: flex;
		flex-direction: column;
		margin: 0 0 0.5em 0;
		font-family: var(--font-atkinson);
		font-weight: 700;
		line-height: 1.15;
	}
	.headline .gradient {
		background: var(--accent-gradient);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}
	.subtitle {
		font-family: var(--font-mono);
		color: var(--color-text-secondary);
		font-size: 0.95em;
		max-width: 65ch;
	}
	.cta {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin: 1.5em 0 0 0;
	}
	.cta .bar {
		display: inline-block;
		width: 4px;
		height: 1.4em;
		border-radius: 2px;
		background: var(--accent-gradient);
	}
	.cta a {
		font-family: var(--font-mono);
		color: var(--color-accent-blue);
		text-decoration: none;
		font-size: 0.95em;
	}
	.cta a:hover {
		text-decoration: underline;
	}
	.label {
		font-family: var(--font-mono);
		color: var(--color-text-tertiary);
		font-size: 0.9em;
		margin: 1.5em 0 1.5em 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
	}
	.card {
		border: 1px solid var(--color-border);
		border-radius: 6px;
		overflow: hidden;
		background: var(--color-card-body);
	}
	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.card-top {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.6em 1em;
		background: var(--color-card-top);
		border-bottom: 1px solid var(--color-border);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.dot-blue {
		background: var(--color-accent-blue);
	}
	.dot-cyan {
		background: var(--color-accent-cyan);
	}
	.card-date {
		font-family: var(--font-mono);
		font-size: 0.75em;
		color: var(--color-text-tertiary);
	}
	.card-body {
		padding: 1em;
	}
	.card-body h3 {
		margin: 0 0 0.5em 0;
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 1.1em;
		color: var(--color-text-primary);
	}
	.card-body p {
		margin: 0;
		font-family: var(--font-atkinson);
		color: var(--color-text-secondary);
		font-size: 0.9em;
	}
	.card-footer {
		padding: 0 1em 1em 1em;
	}
	.tag {
		display: inline-block;
		padding: 0.25em 0.5em;
		border-radius: 3px;
		background: var(--color-tag-bg);
		color: var(--color-tag-text);
		font-family: var(--font-mono);
		font-size: 10px;
		text-transform: uppercase;
	}
	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
