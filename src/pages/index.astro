---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="hero">
				<p class="prompt cursor">$ cat about.txt</p>
				<h1 class="headline">
					<span>Código que</span>
					<span class="gradient">conta histórias</span>
					<span>em produção.</span>
				</h1>
				<p class="subtitle">{SITE_DESCRIPTION}</p>
				<p class="cta">
					<span class="bar" aria-hidden="true"></span>
					<a href="/posts">-&gt; ver todos os posts</a>
				</p>
			</section>
			<hr />
			<section class="about-teaser">
				<p class="label">// sobre</p>
				<p class="about-text">
					{SITE_AUTHOR} é arquiteto de software e escreve aqui sobre o que
					aprende projetando microsserviços e sistemas em produção, e, mais
					recentemente, sobre desenvolvimento agêntico com ferramentas como
					Kiro e Claude Code.
				</p>
				<p class="about-cta">
					<span class="bar" aria-hidden="true"></span>
					<a href="/about">-&gt; saiba mais</a>
				</p>
			</section>
			{featured && (
				<section class="featured">
					<p class="label">// último post</p>
					<article class="card card-featured">
						<a href={`/posts/${featured.id}/`} class="card-link">
							<div class="card-top">
								<span class="dot dot-blue" aria-hidden="true"></span>
								<span class="card-tab">último post</span>
								<span class="card-date">
									<FormattedDate date={featured.data.pubDate} />
								</span>
							</div>
							<div class="card-body">
								<h2>{featured.data.title}</h2>
								<p>{featured.data.description}</p>
							</div>
							{(featured.data.categories[0] ?? featured.data.tags[0]) && (
								<div class="card-footer">
									<span class="tag">
										{featured.data.categories[0] ?? featured.data.tags[0]}
									</span>
								</div>
							)}
						</a>
					</article>
				</section>
			)}
			{rest.length > 0 && (
				<>
					<p class="label">// mais posts</p>
					<div class="grid">
						{rest.map((post, index) => (
							<article class="card">
								<a href={`/posts/${post.id}/`} class="card-link">
									<div class="card-top">
										<span
											class={`dot ${index % 2 === 0 ? 'dot-blue' : 'dot-cyan'}`}
											aria-hidden="true"
										></span>
										<span class="card-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									<div class="card-body">
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
									{(post.data.categories[0] ?? post.data.tags[0]) && (
										<div class="card-footer">
											<span class="tag">{post.data.categories[0] ?? post.data.tags[0]}</span>
										</div>
									)}
								</a>
							</article>
						))}
					</div>
				</>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2em 0 1em 0;
	}
	.prompt {
		margin: 0 0 0.5em 0;
		font-family: var(--font-mono);
		color: var(--color-text-tertiary);
		font-size: 0.9em;
	}
	.headline {
		display: flex;
		flex-direction: column;
		margin: 0 0 0.5em 0;
		font-family: var(--font-atkinson);
		font-weight: 700;
		line-height: 1.15;
	}
	.headline .gradient {
		background: var(--accent-gradient);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}
	.subtitle {
		font-family: var(--font-mono);
		color: var(--color-text-secondary);
		font-size: 0.95em;
		max-width: 65ch;
	}
	.cta {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin: 1.5em 0 0 0;
	}
	.cta .bar {
		display: inline-block;
		width: 4px;
		height: 1.4em;
		border-radius: 2px;
		background: var(--accent-gradient);
	}
	.cta a {
		font-family: var(--font-mono);
		color: var(--color-accent-blue);
		text-decoration: none;
		font-size: 0.95em;
	}
	.cta a:hover {
		text-decoration: underline;
	}
	.label {
		font-family: var(--font-mono);
		color: var(--color-text-tertiary);
		font-size: 0.9em;
		margin: 1.5em 0 1.5em 0;
	}
	.about-teaser {
		margin: 1em 0 0 0;
	}
	.about-teaser .label {
		margin: 1.5em 0 0.75em 0;
	}
	.about-text {
		font-family: var(--font-atkinson);
		color: var(--color-text-secondary);
		font-size: 1em;
		max-width: 65ch;
		margin: 0;
	}
	.about-cta {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin: 1em 0 0 0;
	}
	.about-cta .bar {
		display: inline-block;
		width: 4px;
		height: 1.4em;
		border-radius: 2px;
		background: var(--accent-gradient);
	}
	.about-cta a {
		font-family: var(--font-mono);
		color: var(--color-accent-blue);
		text-decoration: none;
		font-size: 0.95em;
	}
	.about-cta a:hover {
		text-decoration: underline;
	}
	.featured .label {
		margin-bottom: 1em;
	}
	.card-featured {
		border-color: var(--color-accent-blue);
	}
	.card-featured .card-tab {
		font-family: var(--font-mono);
		font-size: 0.75em;
		color: var(--color-accent-blue);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-right: auto;
	}
	.card-featured .card-body {
		padding: 1.5em;
	}
	.card-featured .card-body h2 {
		margin: 0 0 0.5em 0;
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 1.75em;
		line-height: 1.2;
		color: var(--color-text-primary);
	}
	.card-featured .card-body p {
		margin: 0;
		font-family: var(--font-atkinson);
		color: var(--color-text-secondary);
		font-size: 1em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
	}
	.card {
		border: 1px solid var(--color-border);
		border-radius: 6px;
		overflow: hidden;
		background: var(--color-card-body);
	}
	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.card-top {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.6em 1em;
		background: var(--color-card-top);
		border-bottom: 1px solid var(--color-border);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.dot-blue {
		background: var(--color-accent-blue);
	}
	.dot-cyan {
		background: var(--color-accent-cyan);
	}
	.card-date {
		font-family: var(--font-mono);
		font-size: 0.75em;
		color: var(--color-text-tertiary);
	}
	.card-body {
		padding: 1em;
	}
	.card-body h3 {
		margin: 0 0 0.5em 0;
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 1.1em;
		color: var(--color-text-primary);
	}
	.card-body p {
		margin: 0;
		font-family: var(--font-atkinson);
		color: var(--color-text-secondary);
		font-size: 0.9em;
	}
	.card-footer {
		padding: 0 1em 1em 1em;
	}
	.tag {
		display: inline-block;
		padding: 0.25em 0.5em;
		border-radius: 3px;
		background: var(--color-tag-bg);
		color: var(--color-tag-text);
		font-family: var(--font-mono);
		font-size: 10px;
		text-transform: uppercase;
	}
	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
